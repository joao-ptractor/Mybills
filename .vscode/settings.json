{
  // GitHub Copilot — enable custom instruction files
  "github.copilot.chat.codeGeneration.useInstructionFiles": true,

  // Automatically apply instruction files whose `applyTo` glob matches the current file
  "chat.includeApplyingInstructions": true,

  // Directories where Copilot looks for *.instructions.md files
  "chat.instructionsFilesLocations": {
    ".github/instructions": true
  },

  "chat.agentSkillsLocations": {
    ".github/skills": true,
    ".agents/skills": true,
    ".claude/skills": true,
    "~/.copilot/skills": true,
    "~/.agents/skills": true,
    "~/.claude/skills": true
  },

  // Editor — enforce project formatting settings
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "editor.tabSize": 2,
  "[prisma]": {
    "editor.defaultFormatter": "Prisma.prisma"
  },
  "js/ts.tsdk.path": "node_modules\\typescript\\lib"
}
